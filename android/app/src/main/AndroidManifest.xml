<manifest xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- 只读「用了哪个 app、多久」，拿不到内容。不是普通权限：requestPermissions
         要不来，得用户自己去「设置 → 有权查看使用情况的应用」里开，所以
         AndroidManifest 里声明了也只是让系统把这个 App 列进那张名单。
         tools:ignore 是因为 lint 会把它当成不该由普通应用声明的保护级权限。 -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions"/>
    <!-- 定闹钟/倒计时交给系统时钟应用（普通权限，装上即有，不弹框） -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM"/>
    <!-- 日历只读。
         写日历走 intent（打开系统日历的新建页，用户自己点保存），
         所以不需要 WRITE_CALENDAR。

         曾经短暂声明过 WRITE，因为 device_calendar 插件的权限判断是
         `WRITE && READ`，不给写就不让读。后来换成自己查 ContentProvider
         （见 CalendarChannel.kt），才把这个多余的授权去掉。 -->
    <uses-permission android:name="android.permission.READ_CALENDAR"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <!-- 主动推送的通知。Android 13 起是运行时权限，装上不等于有，
         得在 App 里显式要一次（见 NudgeService.ensurePermission）。
         13 以下声明了就有，不弹框。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- ⚠️ 2026-09-08 试开 Impeller。
             原来是 false，为的是修 OPPO/vivo 上的文字渲染损坏。
             但 `ImageFilter.shader`（做折射用的片元着色器）**只在 Impeller 下
             可用**，Skia 直接抛 UnsupportedError。所以「玻璃要有透镜感」和
             「关掉 Impeller」是不能同时成立的。
             那个文字 bug 是早期版本的，Flutter 3.29 的 Impeller 改了很多——
             先开着看真机上文字还坏不坏。坏了就改回 false。 -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- 「一起听歌」：读系统里正在播放的媒体会话（歌名/歌手/播放状态）。

             为什么非得是通知监听？因为第三方 App 调 MediaSessionManager
             .getActiveSessions() 会抛 SecurityException——MEDIA_CONTENT_CONTROL
             是签名级权限，只发给系统应用。官方给第三方留的唯一口子就是：
             自己是个**已被用户启用**的通知监听器，然后拿自己的 ComponentName
             去调 getActiveSessions()。Android 14/15/16 都没动这个 API 本身
             （15 新增的只是「通知里的验证码不许读」，跟媒体无关）。

             代价：这个权限 **requestPermissions 要不来**，必须让用户自己去
             「设置 → 通知使用权」里手动勾一次。所以 Dart 那边是
             hasPermission（问状态）+ openSettings（送人过去）两个方法，
             跟 AppUsageChannel 对 PACKAGE_USAGE_STATS 的写法一模一样，
             中间不假装能自动搞定。

             exported="true" 是安全的：这个服务被 BIND_NOTIFICATION_LISTENER_SERVICE
             保护，而那个权限只有系统持有（CTS 和 Flutter 的同类插件都这么声明）。
             Android 12 起有 intent-filter 的组件必须显式写 exported，不写直接装不上。

             实测（2026-09-27，PKT110 / Android 16）：网易云的会话和元数据都读得到，
             dispatch play/pause 也生效；但**它停止播放后会把 metadata 清空**
             （size 从 12 变 0，进程和会话都还在）——兜底逻辑见 MusicBridge。 -->
        <service
            android:name=".MusicListenerService"
            android:label="@string/app_name"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Android 11+ 需要显式声明才能发现系统语音识别服务 -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
        <!-- 使用情况列表要把包名换成看得懂的名字。安卓 11 起 app 默认看不见
             别的 app，getApplicationInfo 直接抛 NameNotFoundException，于是
             列表里一半是 com.tencent.mm 这种，只有系统应用碰巧翻得出中文名。
             声明「能看见有启动图标的应用」就够了，不用 QUERY_ALL_PACKAGES
             ——那是受限权限，为显示个名字不值当，上架还要额外说明。 -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
        <!-- Android 11+ 需要显式声明才能发现系统 TTS 引擎 -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
    </queries>
</manifest>
