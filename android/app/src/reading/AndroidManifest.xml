<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
        读书版专有：把自己挂进系统的「分享」面板。

        ## 为什么是这条路，而不是接番茄的接口

        有人问能不能从番茄免费小说导入。番茄没有对外接口，唯一的办法是逆向
        它的私有协议——抓包、伪造签名、模拟客户端。那种东西**在他们下次发版
        时就会坏**，坏了还得重来一遍，等于给一个用户背一条永远在漏的管子。

        ACTION_SEND 是安卓的门，不是番茄的门。番茄怎么改版，「分享」这个动作
        都还在，因为那是系统约定。而且这一条同时接住了起点、知乎、浏览器、
        备忘录——任何能分享一段文字的地方。

        **不要为一个 App 造接口，要接住所有 App 都会做的那个动作。**

        ## 为什么放在 flavor 里而不是 main

        主 App（assistant）是她自己的助手，不该出现在别人分享文字时的面板上——
        那一栏本来就挤。这个 filter 只有读书版需要。

        ## ACTION_PROCESS_TEXT 是备胎

        有些阅读器的「分享」是自己画的面板，只有微信 QQ，没有「系统分享」那一项。
        那种情况下，长按选中文字后系统给的菜单里还能看见我们。两条路互相不依赖，
        哪条通走哪条。
    -->
    <application>
        <activity android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity>
        <!-- 看一眼屏幕是主 App 的功能。插件是两个 flavor 共用的，不删掉的话
             无障碍列表里会多出一个「读书讨论 · 让它看一眼屏幕」。 -->
        <service
            android:name="com.phonetool.screen_glance.GlanceService"
            tools:node="remove" />
        <!-- 一起听歌也是主 App 的功能，同理。留着的话「通知使用权」那张名单里
             会多一个「读书讨论」，而它其实什么也不做——用户勾了也没效果，
             只会以为是坏的。 -->
        <service
            android:name=".MusicListenerService"
            tools:node="remove" />
        <!-- 一起听的保命符前台服务。不删的话读书版会冒出一条「在后台听着」的
             常驻通知——一个读书 App 弹这个比没有更糟。
             ⚠️ 但它**必须能被引用**：MusicChannel.kt 在 main source set 里，
             两个 flavor 共用，所以类只能放 main。这里删的是 manifest 条目，
             不是类——删类的话 reading 变体直接编译不过。 -->
        <service
            android:name=".MusicKeepAliveService"
            tools:node="remove" />
    </application>
    <!-- 读书版没有任何前台服务，这条权限是纯负担，一并摘掉。
         （必须在 <manifest> 下，不能塞进 <application>——lint 直接判死。）
         ⚠️ FOREGROUND_SERVICE 那条**不要动**：WorkManager 两个 flavor 都在用
         （SystemForegroundService 要它）。 -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
        tools:node="remove" />
</manifest>
